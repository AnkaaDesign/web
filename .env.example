# Web Application Environment Variables - EXAMPLE
# Copy this file to .env.development, .env.staging, or .env.production
# Vite requires all client-side env vars to be prefixed with VITE_

# API Configuration
# Development:
#   - Local machine: http://localhost:3030
#   - Network access: http://192.168.0.X:3030 (replace X with your machine's IP)
#   - Auto-detect: Run `npm run update-ip` to automatically set your current network IP
# Staging:     https://api.staging.ankaadesign.com.br
# Production:  https://api.ankaadesign.com.br
#
# Note: If your IP address changes frequently (DHCP), you can:
#   1. Run `npm run update-ip` to automatically update this file
#   2. Or manually change the IP below
#   3. Backend is configured to accept any 192.168.0.*, 192.168.1.*, and 10.*.*.* IPs in development
VITE_API_URL=http://localhost:3030
VITE_API_FILES_URL=http://localhost:3030/files

# API Port (used for local network access)
# When the app is accessed via a private IP (e.g. 192.168.x.x from a phone/tablet),
# the API URL is constructed as http://<current-hostname>:<VITE_API_PORT>.
# This allows devices on the same LAN to reach the dev API server.
# Default: 3030
# VITE_API_PORT=3030

# WebSocket Configuration (Socket.io)
# The WebSocket connection uses the same URL as the API
# Socket.io will automatically handle the connection upgrade
# Development: http://localhost:3030
# Staging:     https://api.staging.ankaadesign.com.br
# Production:  https://api.ankaadesign.com.br
# Note: VITE_API_URL is used for both REST API and WebSocket connections

# Truck Studio asset tree
# Where the ~300 MB of studio assets (cab geometry, HDRIs, PBR ground maps,
# manufacturer photos) are served from. They no longer live in web/public/:
# a single file there (models/vehicles/scania.fbx, 44 MB, downloaded at runtime)
# is close to GitHub's 100 MB per-file limit and public/ as a whole had reached
# 446 MB. The API serves the tree now.
#
# The VERSION IS IN THE BASE, not in file names (/studio-assets/v1/...).
# Content-hashing 400+ files would mean rewriting every manifest per bake; a
# version directory makes `Cache-Control: immutable` safe, makes cutover atomic
# (all of v1 -> all of v2) and makes rollback a one-line flip of this variable.
#
# Three supported modes:
#
#   1. Same-origin (DEFAULT — leave it unset, or set it to this)
#      VITE_STUDIO_ASSETS_BASE=/studio-assets/v1
#      In dev, vite.config.ts proxies /studio-assets -> VITE_API_URL.
#      In production, nginx proxies the same prefix to the API.
#      Same-origin means no CORS preflight per .glb/.hdr, and no tainted canvas
#      (livery.ts reads panel PNGs back with getImageData()).
#
#   2. Absolute API origin (web and API on different hosts, no shared proxy)
#      VITE_STUDIO_ASSETS_BASE=https://api.ankaadesign.com.br/studio-assets/v1
#      The API MUST send Access-Control-Allow-Origin for this: three.js sets
#      crossOrigin="anonymous" on its loaders, so a missing header is not a
#      taint, it is a failed load.
#
#   3. Standalone static server (offline work, or bisecting an asset bake)
#      VITE_STUDIO_ASSETS_BASE=http://localhost:8080
#      e.g. `python3 -m http.server 8080` inside a directory holding
#      models/ textures/ environments/ brands/. Note there is no /v1 here —
#      whatever you point at IS the root of the tree.
#
# Trailing slashes are stripped; do not append one.
# VITE_STUDIO_ASSETS_BASE=/studio-assets/v1

# Application Root Path (server-side app installation directory)
# Used by backup path presets to avoid hardcoding user-specific paths
# VITE_APP_ROOT=/home/kennedy/ankaa

# Deployment Domain Labels (shown in deployment manager UI)
# VITE_STAGING_DOMAIN=test.ankaadesign.com.br
# VITE_PRODUCTION_DOMAIN=ankaadesign.com.br

# Mobile App URI Scheme (custom URL protocol for deep links)
# VITE_APP_SCHEME=ankaadesign

# Rate Limiting (set to true to disable in development)
DISABLE_RATE_LIMITING=false

# Firebase Cloud Messaging (Push Notifications)
# Get these values from Firebase Console: https://console.firebase.google.com/
# Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
# Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=your-vapid-key
